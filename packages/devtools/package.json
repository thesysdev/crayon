{
  "name": "@openuidev/devtools",
  "version": "0.0.1",
  "description": "Development-only diagnostics and helpers for OpenUI applications",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format:fix": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "check:publint": "publint",
    "check:attw": "attw --pack .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run check:publint && pnpm run check:attw",
    "ci": "pnpm run lint:check && pnpm run format:check"
  },
  "peerDependencies": {
    "@openuidev/react-ui": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@openuidev/react-ui": "workspace:^",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "openui",
    "devtools",
    "debugging",
    "react",
    "cloud",
    "diagnostics"
  ],
  "homepage": "https://openui.com",
  "author": "engineering@thesys.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesysdev/openui.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/thesysdev/openui/issues"
  }
}
