{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openui.com/schema/a2ui/v1.0/renderer-data-model.json",
  "title": "A2UI v1.0 renderer data model",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "v1.0"
    },
    "surfaces": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "$ref": "#/$defs/__schema0"
        }
      }
    }
  },
  "required": [
    "version",
    "surfaces"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
