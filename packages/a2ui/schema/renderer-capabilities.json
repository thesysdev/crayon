{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openui.com/schema/a2ui/v1.0/renderer-capabilities.json",
  "title": "A2UI v1.0 renderer capabilities",
  "type": "object",
  "properties": {
    "v1.0": {
      "type": "object",
      "properties": {
        "supportedCatalogIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inlineCatalogs": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        }
      },
      "required": [
        "supportedCatalogIds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v1.0"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
