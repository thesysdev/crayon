{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openui.com/schema/a2ui-lang/v1.0/agent-capabilities.json",
  "title": "A2UI v1.0 agent capabilities",
  "type": "object",
