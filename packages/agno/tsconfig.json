{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@openuidev/react-headless": ["../react-headless/dist/index.d.mts"]
    },
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true
  }
}
