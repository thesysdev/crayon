{
  "name": "openui-tui-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal (Ink/TUI) chat client that renders streamed OpenUI Lang as an interactive terminal UI.",
  "bin": {
    "openui-tui-chat": "src/cli.tsx"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openuidev/lang-core": "workspace:*",
    "@openuidev/react-headless": "workspace:*",
    "ink": "^5.1.0",
    "ink-big-text": "^2.0.0",
    "ink-spinner": "^5.0.0",
    "openai": "^6.22.0",
    "react": "^18.3.1",
    "zod": "^4.3.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
