# Authenticate once with `grok login`, or set an API key for headless environments.
# XAI_API_KEY=xai-...

# Grok Build executable. Defaults to `grok` on PATH.
# GROK_BUILD_BIN=/absolute/path/to/grok

# Workspace the coding agent can inspect and modify. Defaults to this example directory.
# GROK_BUILD_CWD=/absolute/path/to/project

# Optional model override. When omitted, the installed Grok Build CLI chooses its configured default.
# GROK_BUILD_MODEL=

# Headless tool execution is auto-approved by default so turns cannot stall on a terminal prompt.
# Set this to false and configure Grok permissions if you do not want that behavior.
# GROK_BUILD_ALWAYS_APPROVE=true

# Optional model reasoning effort.
# GROK_BUILD_REASONING_EFFORT=high
