{
  "name": "grok-build-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:openui": "pnpm --filter @openuidev/react-ui... build && pnpm --filter @openuidev/cli build",
    "generate:prompt": "pnpm build:openui && node ../../../packages/openui-cli/dist/index.js generate src/library.ts --out src/generated/system-prompt.txt && node ../../../packages/openui-cli/dist/index.js generate src/library.ts --json-schema --out src/generated/component-spec.json",
    "dev": "pnpm generate:prompt && next dev",
    "build": "pnpm generate:prompt && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.53",
    "@agentclientprotocol/sdk": "0.10.0",
    "@openuidev/lang-core": "workspace:*",
    "@openuidev/react-headless": "workspace:*",
    "@openuidev/react-lang": "workspace:*",
    "@openuidev/react-ui": "workspace:*",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openuidev/cli": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
