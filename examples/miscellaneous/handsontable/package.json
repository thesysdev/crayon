{
  "name": "@openuidev/example-handsontable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "generate:prompt": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "predev": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "dev": "next dev",
    "prebuild": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "build": "next build",
