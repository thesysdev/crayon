    "verify": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@handsontable/react-wrapper": "^17.0.1",
    "@openuidev/cli": "0.2.11",
    "@openuidev/react-headless": "0.9.13",
    "@openuidev/react-lang": "0.2.15",
    "@openuidev/react-ui": "0.13.10",
    "@openuidev/thesys-server": "0.1.3",
    "handsontable": "^17.0.1",
    "hyperformula": "^3.2.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "zod": "^4.3.6",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openuidev/lang-core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
