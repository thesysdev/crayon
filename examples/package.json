{
  "name": "@openuidev/examples-workspace",
  "private": true,
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile",
    "update:openui": "pnpm --recursive update --latest \"@openuidev/*\"",
    "verify": "pnpm --recursive --workspace-concurrency=1 run verify"
  },
  "pnpm": {
    "overrides": {
      "langsmith@<0.6.0": "^0.6.0",
      "ip-address@<10.1.1": ">=10.1.1",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@<6.15.2": ">=6.15.2",
      "uuid@<11.1.1": "^11.1.1",
      "cookie@<0.7.0": "1.1.1",
      "@sveltejs/kit>cookie": "1.1.1",
      "prismjs@<1.30.0": ">=1.30.0",
      "@ai-sdk/provider-utils@<=3.0.97": "^4.0.27",
      "@ai-sdk/ui-utils@1.2.11>@ai-sdk/provider-utils": "2.2.8"
    }
  }
}
